digraph muyo_llm {
  rankdir=LR;
  graph [fontname="monospace", compound=true];
  node [shape=box, fontsize=10, fontname="monospace"];
  edge [fontsize=9];
  "b0.pre_norm" [style=filled, fillcolor="#dbeafe"];
  "b0.q_proj" [style=filled, fillcolor="#dbeafe"];
  "b0.k_proj" [style=filled, fillcolor="#dbeafe"];
  "b0.v_proj" [style=filled, fillcolor="#dbeafe"];
  "b0.q_rope" [style=filled, fillcolor="#dbeafe"];
  "b0.k_rope" [style=filled, fillcolor="#dbeafe"];
  "b0.v_copy" [style=filled, fillcolor="#dbeafe"];
  "b0.attn_scores" [style=filled, fillcolor="#dbeafe"];
  "b0.attn_weights" [style=filled, fillcolor="#dbeafe"];
  "b0.attn_output" [style=filled, fillcolor="#dbeafe"];
  "b0.o_proj" [style=filled, fillcolor="#dbeafe"];
  "b0.residual1" [style=filled, fillcolor="#dbeafe"];
  "b0.post_norm" [style=filled, fillcolor="#dbeafe"];
  "b0.gate_proj" [style=filled, fillcolor="#dbeafe"];
  "b0.up_proj" [style=filled, fillcolor="#dbeafe"];
  "b0.swiglu" [style=filled, fillcolor="#dbeafe"];
  "b0.down_proj" [style=filled, fillcolor="#dbeafe"];
  "b0.residual2" [style=filled, fillcolor="#dbeafe"];
  "b1.pre_norm" [style=filled, fillcolor=gray95];
  "embed" [style=filled, fillcolor=gray95];
  "b0.pre_norm" -> "b0.q_proj";
  "b0.pre_norm" -> "b0.k_proj";
  "b0.pre_norm" -> "b0.v_proj";
  "b0.q_proj" -> "b0.q_rope";
  "b0.k_proj" -> "b0.k_rope";
  "b0.v_proj" -> "b0.v_copy";
  "b0.q_rope" -> "b0.attn_scores";
  "b0.k_rope" -> "b0.attn_scores";
  "b0.v_copy" -> "b0.attn_scores";
  "b0.attn_scores" -> "b0.attn_weights";
  "b0.attn_weights" -> "b0.attn_output";
  "b0.attn_output" -> "b0.o_proj";
  "b0.o_proj" -> "b0.residual1";
  "b0.residual1" -> "b0.post_norm";
  "b0.post_norm" -> "b0.gate_proj";
  "b0.post_norm" -> "b0.up_proj";
  "b0.gate_proj" -> "b0.swiglu";
  "b0.up_proj" -> "b0.swiglu";
  "b0.swiglu" -> "b0.down_proj";
  "b0.down_proj" -> "b0.residual2";
  "b0.residual2" -> "b1.pre_norm";
  "embed" -> "b0.pre_norm";
}
