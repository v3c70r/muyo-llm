#version 460

// M0 smoke shader: the smallest thing that proves the graph can run a compute node.
// It writes a deterministic pattern so the result can be checked on the host. Since Muyo's
// descriptor-heap track (B1b) the graph has no descriptor sets or pipeline layout: the buffer is
// reached through the resource heap by the index in push data, and the host fills that index from
// RenderGraphNodeContext::GetHeapIndex at record time.

#extension GL_EXT_descriptor_heap : require
#extension GL_EXT_nonuniform_qualifier : require

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout (descriptor_heap) buffer Data
{
    uint values[];
}
data[];

layout (push_constant) uniform PushConstants
{
    uint count;
    uint dataIndex;
}
pc;

void main()
{
    const uint index = gl_GlobalInvocationID.x;
    if (index < pc.count)
    {
        data[nonuniformEXT(pc.dataIndex)].values[index] = index * 3u + 1u;
    }
}
